#!/bin/zsh
set -ex

zparseopts -D -E -F -- -no-sleep=no_sleep

if ! git diff --exit-code --no-patch; then
  echo "Uncommitted changes."
  exit 1
fi

git switch $(if git rev-parse --quiet --verify main >/dev/null; then echo -n main; else; echo -n master; fi)
git pull

if git rev-parse --quiet --verify upgrade_dependencies; then
  echo "Branch upgrade_dependencies already exists."
  exit
fi

# Upgrade Python dependencies
if [[ -f uv.lock ]]; then
  uv lock --upgrade
fi

# Upgrade pinned Rust version
if [[ -f rust-toolchain.toml ]]; then
  cache_file=${XDG_CACHE_HOME:-$HOME/.cache}/pr-upgrade-dependencies/rust-stable-version
  mkdir -p ${cache_file:h}
  touch $cache_file.lock
  (
    zmodload zsh/system
    zsystem flock $cache_file.lock
    if [[ -z $(find $cache_file -mmin -60 2>/dev/null) ]]; then
      curl -sSf https://raw.githubusercontent.com/rust-lang/rust/stable/src/version -o $cache_file.tmp
      mv $cache_file.tmp $cache_file
    fi
  )
  latest_rust_version=$(<$cache_file)
  sd '^channel = "[0-9.]+"' "channel = \"${latest_rust_version%.*}\"" rust-toolchain.toml
  # Match MSRV to the toolchain, only for packages not published to crates.io
  if rg -q '^publish = false' Cargo.toml 2>/dev/null; then
    sd '^rust-version = "[0-9.]+"' "rust-version = \"${latest_rust_version%.*}\"" Cargo.toml
  fi
fi

# Upgrade Rust dependencies
if [[ -f Cargo.lock ]]; then
  cargo update
fi

# Upgrade GitHub Actions actions
# Suspended due hitting rate limits: https://github.com/davidism/gha-update/issues/12
# if [[ -d .github/workflows ]]; then
#   uvx gha-update
# fi

if git diff --exit-code --no-patch; then
  echo "No changes."
  exit
fi

git switch -c upgrade_dependencies
git commit -m 'Upgrade dependencies' -a

git push
gh pr create --fill
sleep 1
gh pr merge --squash --delete-branch --auto upgrade_dependencies
# Workaround to avoid hitting GitHub rate limit of ~10 PRs per minute
if (( ! $#no_sleep )); then
  sleep 19
fi
